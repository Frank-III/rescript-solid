    "@solid-primitives/map": "^0.7.1",
    "@solid-primitives/match": "^0.0.100",
    "@solid-primitives/media": "^2.3.4",
    "@solid-primitives/resize-observer": "^2.1.4",
    "@solid-primitives/set": "^0.7.2",
    "@solid-primitives/trigger": "^1.2.2",
    "@solidjs/router": "catalog:",
    "rescript": "catalog:",
    "rescript-solid": "workspace:*",
    "rescript-solid-router": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }

    "res:watch": "bun run ppx:native:build && rescript -w",
    "preview": "vite preview"
  },
  "dependencies": {
    "@corvu/resizable": "^0.2.5",
    "@kobalte/core": "^0.13.11",
    "@solid-primitives/event-listener": "^2.4.3",

{
  "name": "solid-examples-router",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run res:build && vite build",
    "dev": "vite",
    "ppx:native:build": "opam exec -- dune build --root ../../packages/rescript-show-ppx-native",
    "res:build": "bun run ppx:native:build && rescript",
    "res:clean": "rescript clean",
    "res:watch": "bun run ppx:native:build && rescript -w",
    "preview": "vite preview"
  },
  "dependencies": {
    "rescript-solid": "workspace:*",
    "rescript-solid-router": "workspace:*",
    "solid-js": "catalog:",
    "@solidjs/web": "catalog:",
    "@solidjs/h": "catalog:",

    "@solidjs/router": "catalog:"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }
}
